{
  "name": "MARKUP",
  "version": "1.0.0",
  "manifest_version": 3,
  "description": "MARKUP browser annotation extension",
  "permissions": ["activeTab", "storage", "scripting", "tabs", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "MARKUP",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
